# Nebius Token Factory (https://tokenfactory.nebius.com): create an API key under API keys.
NEBIUS_API_KEY=
# Optional. The default is the public endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Optional model overrides (the defaults are in server/nebius.js).
NEBIUS_ROUTER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
NEBIUS_ANALYST_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_CLOSER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Optional usage limits for a public copy. With these two set, counts live in Upstash Redis.
KV_REST_API_URL=
KV_REST_API_TOKEN=
LIMIT_PER_ADDRESS=30
LIMIT_WINDOW_SECONDS=600
LIMIT_DAILY_UNITS=1200
